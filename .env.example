# Server-only OpenAI credentials. Never expose this value to the browser.
OPENAI_API_KEY=

# Model used by the server-side interpretation route.
OPENAI_MODEL=gpt-5.4-mini

# Deepgram credentials for live transcription. Credentials remain in this
# local service and are never sent to the native client.
DEEPGRAM_API_KEY=

# Optional live transcription model.
DEEPGRAM_MODEL=nova-2

# Optional local API port used by the Vite development proxy.
API_PORT=8787

# Python that can run MonkeyForge (the superpower classifier). Defaults to
# tools/monkeyforge/.venv; point this at another interpreter if yours lives elsewhere.
MONKEYFORGE_PYTHON=
