# Server-only OpenAI credentials. Never expose this value to the browser.
OPENAI_API_KEY=

# Model used by the server-side interpretation route.
OPENAI_MODEL=gpt-5.4-mini

# Optional live transcription model. Credentials remain in this local service.
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe

# Optional local API port used by the Vite development proxy.
API_PORT=8787
