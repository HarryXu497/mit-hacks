.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# Generated character jobs and large model artifacts
data/jobs/*
!data/jobs/.gitkeep
data/cache/*
!data/cache/.gitkeep
models/
checkpoints/
*.safetensors
*.ckpt
*.pt
*.pth

# Blender and generated assets
*.blend1
output/
.pytest-tmp/

# Worker-side generated GLB cache
worker/cache/

# Offline arm64 wheel bundle, rebuilt with worker/offline/README.md
worker/offline/wheels/

# Proprietary prototype references are local-only. Keep the audit note tracked.
assets/reference/btd6_prototype/*
!assets/reference/btd6_prototype/README.md
# Same policy for the 2D style sheets and icon sheets: private style reference only,
# never the public repo, the released game, or a shipped training set.
assets/reference/btd6_icons/*
!assets/reference/btd6_icons/README.md
assets/reference/btd6_style_2d/*
!assets/reference/btd6_style_2d/README.md
assets/reference/btd6_extract/*
assets/base/*.glb
assets/work/*
!assets/work/.gitkeep
