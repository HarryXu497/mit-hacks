{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://monkeyforge.local/schemas/character_spec.schema.json",
  "title": "MonkeyForge CharacterSpec v1",
  "type": "object",
  "required": ["schema_version", "name", "archetype", "body_morphs", "palette", "accessories", "ability"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "archetype": { "enum": ["balanced", "runner", "playmaker", "defender", "goalkeeper"] },
    "body_morphs": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "palette": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
    },
    "accessories": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "slot", "kind", "description", "target_triangles"],
        "properties": {
          "id": { "type": "string" },
          "slot": { "enum": ["head_top", "face", "back", "waist", "hand_left", "hand_right", "tail_tip"] },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "target_triangles": { "type": "integer", "minimum": 100, "maximum": 5000 },
          "part_schema": { "type": "array", "items": { "type": "string" }, "maxItems": 8 }
        },
        "additionalProperties": false
      }
    },
    "ability": {
      "type": "object",
      "required": ["id", "magnitude", "duration_seconds", "cooldown_seconds"],
      "properties": {
        "id": { "enum": ["none", "tailwind", "curve_shot", "rally", "intercept_read", "goalie_focus", "shield_wall"] },
        "magnitude": { "type": "number", "minimum": 0, "maximum": 0.35 },
        "duration_seconds": { "type": "number", "minimum": 0, "maximum": 8 },
        "cooldown_seconds": { "type": "number", "minimum": 5, "maximum": 60 }
      },
      "additionalProperties": false
    }
  }
}

